{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fault Injection Event — Day 0 Contract v1.1",
  "type": "object",
  "required": ["event_id", "fault_type", "target_type", "start_ts_epoch_ms", "severity_params", "injected_by"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "fault_type": {"type": "string", "enum": ["link_failure", "node_failure", "congestion_burst", "abnormal_traffic"]},
    "target_type": {"type": "string", "enum": ["link", "node"]},
    "target_link_id": {"type": ["string", "null"], "pattern": "^L[0-9]+$"},
    "target_node_id": {"type": ["string", "null"], "pattern": "^[sh][0-9]+$"},
    "start_ts_epoch_ms": {"type": "integer", "minimum": 0},
    "end_ts_epoch_ms": {"type": ["integer", "null"], "minimum": 0},
    "severity_params": {"type": "object"},
    "seed": {"type": ["integer", "null"]},
    "injected_by": {"type": "string"},
    "run_id": {"type": ["string", "null"], "description": "FK -> experiment_runs. Null pre-Phase-5, required from Phase 5 onward."},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"target_type": {"const": "link"}}},
      "then": {
        "required": ["target_link_id"],
        "properties": {
          "target_link_id": {"type": "string"},
          "target_node_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"target_type": {"const": "node"}}},
      "then": {
        "required": ["target_node_id"],
        "properties": {
          "target_node_id": {"type": "string"},
          "target_link_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"fault_type": {"const": "congestion_burst"}}},
      "then": {
        "properties": {
          "severity_params": {
            "type": "object",
            "required": ["burst_rate_mbps", "duration_s", "competing_flow_count"]
          }
        }
      }
    },
    {
      "if": {"properties": {"fault_type": {"const": "abnormal_traffic"}}},
      "then": {
        "properties": {
          "severity_params": {
            "type": "object",
            "required": ["pattern"]
          }
        }
      }
    }
  ],
  "example": {
    "event_id": "c4a2d3b0-2222-4a2b-9c3d-000000000001",
    "fault_type": "congestion_burst",
    "target_type": "link",
    "target_link_id": "L1",
    "target_node_id": null,
    "start_ts_epoch_ms": 1735999200000,
    "end_ts_epoch_ms": 1735999260000,
    "severity_params": {"burst_rate_mbps": 80.0, "duration_s": 60, "competing_flow_count": 3},
    "seed": 42,
    "injected_by": "fault_injector.py@v0.3",
    "run_id": "run_0007",
    "notes": null
  }
}
