{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry Records — Day 0 Contract v1.1",
  "definitions": {
    "link_telemetry": {
      "type": "object",
      "required": ["record_id", "ts_epoch_ms", "link_id", "latency_ms", "latency_method",
                   "packet_loss_pct", "throughput_mbps", "utilization_pct", "queue_length",
                   "active_flows", "poll_interval_ms"],
      "properties": {
        "record_id": {"type": "string", "format": "uuid"},
        "ts_epoch_ms": {"type": "integer", "minimum": 0, "description": "Time reply/reading was received, not when poll was sent."},
        "link_id": {"type": "string", "pattern": "^L[0-9]+$"},
        "latency_ms": {"type": "number", "minimum": 0},
        "latency_method": {"type": "string", "enum": ["lldp_probe", "configured_static"]},
        "packet_loss_pct": {"type": "number", "minimum": 0, "maximum": 100, "description": "Derived from of_stats counter deltas, not active probe loss."},
        "throughput_mbps": {"type": "number", "minimum": 0, "description": "Derived from of_stats byte-counter delta."},
        "utilization_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "queue_length": {"type": "integer", "minimum": 0, "description": "Via tc/netem backlog (pyroute2), not OVS/OpenFlow."},
        "active_flows": {"type": "integer", "minimum": 0, "description": "Via of_stats flow-table query filtered to this link's egress port."},
        "poll_interval_ms": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false,
      "example": {
        "record_id": "b3f1c2a0-1111-4a2b-9c3d-000000000001",
        "ts_epoch_ms": 1735999200000,
        "link_id": "L1",
        "latency_ms": 4.2,
        "latency_method": "lldp_probe",
        "packet_loss_pct": 0.0,
        "throughput_mbps": 12.4,
        "utilization_pct": 12.4,
        "queue_length": 3,
        "active_flows": 5,
        "poll_interval_ms": 1000
      }
    },
    "node_telemetry": {
      "type": "object",
      "required": ["record_id", "ts_epoch_ms", "node_id", "active_flows", "source"],
      "properties": {
        "record_id": {"type": "string", "format": "uuid"},
        "ts_epoch_ms": {"type": "integer", "minimum": 0},
        "node_id": {"type": "string", "pattern": "^[sh][0-9]+$"},
        "cpu_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Always null for kind:switch (shared ovs-vswitchd process, no per-switch CPU). Populated via psutil for kind:host."},
        "ram_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Same nullability rule as cpu_pct."},
        "active_flows": {"type": "integer", "minimum": 0, "description": "Via of_stats; always 0 for hosts."},
        "source": {"type": "string", "enum": ["psutil", "of_stats"]}
      },
      "additionalProperties": false,
      "example": {
        "record_id": "b3f1c2a0-1111-4a2b-9c3d-000000000002",
        "ts_epoch_ms": 1735999200000,
        "node_id": "h1",
        "cpu_pct": 12.5,
        "ram_pct": 34.0,
        "active_flows": 0,
        "source": "psutil"
      }
    }
  }
}
